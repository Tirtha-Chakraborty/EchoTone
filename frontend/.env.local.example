# Optional: call FastAPI directly from the browser (must list this origin in FastAPI CORS).
# If unset, the app uses /api/echotone/* (Next.js rewrites to FastAPI — no CORS in the browser).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Where Next.js proxies /api/echotone/* (server-side only; default 127.0.0.1:8000).
# BACKEND_URL=http://127.0.0.1:8000
